# Kalico MCU build config for the stock Sovol SV06 mainboard (GD32F103RET6,
# an STM32F103 clone). Values from Kalico config/printer-sovol-sv06-2022.cfg
# at the pinned commit (host/roles/klipper_multi/defaults/main.yml):
# STM32F103, 28KiB bootloader, serial on USART1 PA10/PA9 (the board's CH340
# bridge), Disable SWD at startup for the GigaDevice clone.
# Expanded with `make olddefconfig` by `just sv06-firmware`.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32_FLASH_START_7000=y
CONFIG_STM32_SERIAL_USART1=y
CONFIG_STM32F103GD_DISABLE_SWD=y
CONFIG_SERIAL_BAUD=250000
